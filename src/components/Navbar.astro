---
<nav class="navbar" id="mainNav">
  <div class="container nav-container">
    <a href="#inicio" class="logo">
      <span class="logo-icon">M</span>
      <div class="logo-text">
        <span>ESTUDIO</span>
        <span class="text-gold">MITRE</span>
      </div>
    </a>
    
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <div class="nav-menu" id="navMenu">
      <ul class="nav-links">
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#areas">Áreas de Práctica</a></li>
        <li><a href="#estudio">El Estudio</a></li>
      </ul>
      <div class="nav-cta">
        <a href="#contacto" class="btn-primary">Consulta Gratuita</a>
      </div>
    </div>
  </div>
</nav>

<script>
  // 1. Lógica del Menú Móvil
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('navMenu');
  const links = document.querySelectorAll('.nav-links a');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('active');
      toggle.classList.toggle('active');
      document.body.classList.toggle('no-scroll');
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('active');
        toggle.classList.remove('active');
        document.body.classList.remove('no-scroll');
      });
    });
  }

  // 2. Lógica del Scroll (Transparente -> Fondo Sólido)
  const nav = document.getElementById('mainNav');
  
  // SOLUCIÓN: Verificamos que 'nav' exista antes de usarlo
  if (nav) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    });
  }
</script>

<style>
  /* ESTADO INICIAL (Transparente) */
  .navbar {
    position: fixed;
    top: 0; left: 0; width: 100%;
    height: var(--nav-height);
    background: transparent; /* Transparente al inicio */
    border-bottom: 1px solid transparent; /* Sin borde al inicio */
    z-index: 1000;
    transition: all 0.4s ease; /* Transición suave */
  }

  /* ESTADO SCROLLED (Fondo Oscuro + Blur) */
  .navbar.scrolled {
    background: rgba(8, 12, 19, 0.90);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(191, 161, 122, 0.1);
    height: 80px; /* Opcional: se achica un poco al bajar */
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  /* LOGO */
  .logo { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; color: #fff; }
  .logo-icon {
    font-family: var(--font-heading); font-size: 1.5rem; color: var(--color-gold-muted);
    border: 1px solid var(--color-gold-muted); width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center; border-radius: 50%;
  }
  .logo-text { display: flex; flex-direction: column; font-family: var(--font-heading); line-height: 1; letter-spacing: 1px; font-weight: 600; }
  .text-gold { color: var(--color-gold-muted); }

  /* LINKS */
  .nav-menu { display: flex; align-items: center; gap: 3rem; }
  .nav-links { display: flex; gap: 2rem; list-style: none; padding: 0; margin: 0; }
  .nav-links a {
    color: var(--color-text-white); text-decoration: none; text-transform: uppercase;
    font-size: 0.75rem; letter-spacing: 1.5px; opacity: 0.9; transition: all 0.3s;
  }
  .nav-links a:hover { color: var(--color-gold-muted); opacity: 1; }

  /* MOBILE TOGGLE */
  .menu-toggle { display: none; background: none; border: none; cursor: pointer; flex-direction: column; gap: 6px; }
  .bar { width: 25px; height: 2px; background-color: var(--color-gold-muted); transition: 0.3s; }

  /* MOBILE RESPONSIVE */
  @media (max-width: 768px) {
    .menu-toggle { display: flex; z-index: 1002; }
    .menu-toggle.active .bar:nth-child(1) { transform: rotate(45deg) translate(5px, 6px); }
    .menu-toggle.active .bar:nth-child(2) { transform: rotate(-45deg) translate(5px, -6px); }

    .nav-menu {
      position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
      background: var(--color-navy-dark); flex-direction: column; justify-content: center;
      gap: 3rem; transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 1001;
    }
    .nav-menu.active { transform: translateX(0); }
    .nav-links { flex-direction: column; text-align: center; gap: 2.5rem; }
    .nav-links a { font-size: 1.5rem; }
  }
  
  :global(.no-scroll) { overflow: hidden; }
</style>